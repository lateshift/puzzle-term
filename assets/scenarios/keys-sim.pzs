# K5c: one Ctrl+D starts a two-second 33-ms repeat stream in the child.
# Captured PTY groups are replayed at every refresh phase, not merely checked
# in their final erased state; each hold must present settled frames.
shell "stty raw -echo; exec <bin> keyecho --kitty 1 --gap 2 --repeat-ms 33"
wait-idle 40ms max 2s
input ctrl+d
wait-idle 40ms max 4s
expect-paced-repeat-no-marker 2
expect-pty-key ctrl+d
render-shell
expect-drawn 28 "flags=1 last=ctrl"
expect-drawn-not 29:69-29:79 "^"
expect-drawn-grid
expect-cold-match
shell "stty raw -echo; exec <bin> keyecho --kitty 1 --gap 5 --repeat-ms 33"
wait-idle 40ms max 2s
input ctrl+d
wait-idle 40ms max 4s
expect-paced-repeat-no-marker 5
expect-pty-key ctrl+d
render-shell
expect-drawn 28 "flags=1 last=ctrl"
expect-drawn-not 29:69-29:79 "^"
expect-drawn-grid
expect-cold-match
