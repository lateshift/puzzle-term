expect-pty-key ctrl+e
render-shell
expect-drawn 28 "flags=31 last=ctrl"
expect-drawn-not 29:69-29:79 "^"
expect-drawn-not 0:0-29:99 "RAW:"
expect-drawn-grid
expect-cold-match
