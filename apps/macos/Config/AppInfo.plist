<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Xcode merges this custom preset location with its generated standard bundle metadata. -->
<plist version="1.0">
<dict>
    <!-- Expand the checkout that built the app, never the Finder launch directory. -->
    <key>PuzzleRepositoryRoot</key>
    <string>$(PUZZLE_REPOSITORY_ROOT)</string>
</dict>
</plist>
