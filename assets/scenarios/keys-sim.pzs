# K4: macOS-shaped Ctrl letters across legacy and kitty modes.
# Each key has a quiet boundary before asserting transport bytes and GPU pixels.
shell "stty raw -echo; exec <bin> keyecho --kitty 0"
wait-idle 40ms max 2s
input ctrl+a
wait-idle 20ms max 2s
expect-pty-key ctrl+a
render-shell
expect-drawn 28 "flags=0 last=ctrl"
expect-drawn-not 29:69-29:79 "^"
expect-drawn-not 0:0-29:99 "RAW:"
expect-drawn-grid
expect-cold-match

input ctrl+b
wait-idle 20ms max 2s
expect-pty-key ctrl+b
render-shell
expect-drawn 28 "flags=0 last=ctrl"
expect-drawn-not 29:69-29:79 "^"
expect-drawn-not 0:0-29:99 "RAW:"
expect-drawn-grid
expect-cold-match
