# K5b: measured editor erase gaps cross the same real PTY and GPU path.
shell "stty raw -echo; exec <bin> keyecho --kitty 1 --gap 2"
wait-idle 40ms max 2s
input ctrl+d
wait-idle 20ms max 2s
expect-paced-no-marker 2
expect-pty-key ctrl+d
render-shell
expect-drawn 28 "flags=1 last=ctrl"
expect-drawn-not 29:69-29:79 "^"
expect-drawn-grid
expect-cold-match
input ctrl+u
wait-idle 20ms max 2s
expect-paced-no-marker 2
expect-pty-key ctrl+u
render-shell
expect-drawn 28 "flags=1 last=ctrl"
expect-drawn-not 29:69-29:79 "^"
expect-drawn-grid
expect-cold-match
input ctrl+x
wait-idle 20ms max 2s
expect-paced-no-marker 2
expect-pty-key ctrl+x
render-shell
expect-drawn 28 "flags=1 last=ctrl"
expect-drawn-not 29:69-29:79 "^"
expect-drawn-grid
expect-cold-match
