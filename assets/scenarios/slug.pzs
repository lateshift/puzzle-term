# M3 Slug scenes: the GPU reads packed synthetic and real-font atlas data.
# The corner check catches an incorrect clear; the ink range rejects blank
# output and a solidly filled quad before golden comparison runs.
slug-scene small
screenshot small
expect-pixel 0 0 #000000 0
expect-ink-px 0:0-44:44 1% 50%
